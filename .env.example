# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# SQLite (Local Dev Zero-Setup Default):
DATABASE_URL="file:./dev.db"
# PostgreSQL (Docker / Production):
# DATABASE_URL="postgresql://username:password@localhost:5432/eclipto_db?schema=public"

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Initial Seed Administrator Credentials
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_strong_password_123!
INITIAL_ADMIN_NAME="Admin User"

# Optional SMTP Email Notifications (Leave blank to disable)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
NOTIFICATION_RECIPIENT=notifications@example.com
